# Database (docker-compose overrides this to point at the postgres container)
DATABASE_URL=postgresql://dlauser:dlapassword@localhost:5432/digital_life_auditor

# Plaid (get sandbox keys from https://dashboard.plaid.com)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox
# Android bank-OAuth (Chase etc.): set to the app's package name AFTER registering it in the Plaid
# dashboard (Developers > API > Allowed Android package names). Leave empty until then.
PLAID_ANDROID_PACKAGE_NAME=

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change_this_to_a_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional key for encrypting Plaid access tokens at rest (defaults to a key derived from JWT_SECRET).
# Changing it makes previously stored tokens unreadable, so users would need to reconnect their banks.
TOKEN_ENCRYPTION_KEY=

# Groq (free tier: https://console.groq.com). Optional - without a key the app uses
# rule-based insights instead of the LLM.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: public HTTPS URL of POST /plaid/webhook so Plaid can push updates (new transactions,
# bank re-login needed). Needs a URL Plaid can reach, e.g. an ngrok tunnel while developing.
# Without it, transactions refresh via the daily Airflow sync and pull-to-refresh.
PLAID_WEBHOOK_URL=

# Comma-separated allowed CORS origins. "*" is fine for local development only.
CORS_ORIGINS=*

# Shared secret for the Airflow -> backend call. With docker-compose, set this in a
# ROOT-level .env file instead (compose passes it to both services); see .env.example there.
# AIRFLOW_SYNC_SECRET=change_this_airflow_secret
